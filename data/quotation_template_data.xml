<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="quotation_template_default" model="quotation.template">
        <field name="name">Default Odoo</field>
        <field name="code">default</field>
        <field name="is_default" eval="True"/>
        <field name="sequence">1</field>
    </record>

    <record id="quotation_template_general_proposal" model="quotation.template">
        <field name="name">Phone General Proposal</field>
        <field name="code">general_proposal</field>
        <field name="view_id" ref="quotation_template_content_general_proposal"/>
        <field name="sequence">10</field>
    </record>

    <record id="quotation_template_law" model="quotation.template">
        <field name="name">Phone Law Proposal</field>
        <field name="code">law</field>
        <field name="view_id" ref="quotation_template_content_law"/>
        <field name="sequence">20</field>
    </record>

    <record id="quotation_template_medical" model="quotation.template">
        <field name="name">Phone Medical Proposal</field>
        <field name="code">medical</field>
        <field name="view_id" ref="quotation_template_content_medical"/>
        <field name="sequence">30</field>
    </record>

    <record id="quotation_template_religious" model="quotation.template">
        <field name="name">Phone Religious Proposal</field>
        <field name="code">religious</field>
        <field name="view_id" ref="quotation_template_content_religious"/>
        <field name="sequence">40</field>
    </record>

    <record id="quotation_template_phone_system" model="quotation.template">
        <field name="name">Phone System AI Calling</field>
        <field name="code">phone_system</field>
        <field name="view_id" ref="quotation_template_content_phone_system"/>
        <field name="sequence">50</field>
    </record>

    <record id="quotation_template_it_general" model="quotation.template">
        <field name="name">IT General Proposal</field>
        <field name="code">it_general</field>
        <field name="view_id" ref="quotation_template_content_it_general"/>
        <field name="sequence">55</field>
    </record>

    <record id="quotation_template_it_law" model="quotation.template">
        <field name="name">IT Law Proposal</field>
        <field name="code">it_law</field>
        <field name="view_id" ref="quotation_template_content_it_law"/>
        <field name="sequence">56</field>
    </record>

    <record id="quotation_template_it_medical" model="quotation.template">
        <field name="name">IT Medical Proposal</field>
        <field name="code">it_medical</field>
        <field name="view_id" ref="quotation_template_content_it_medical"/>
        <field name="sequence">57</field>
    </record>

    <record id="quotation_template_it_religious" model="quotation.template">
        <field name="name">IT Religious Proposal</field>
        <field name="code">it_religious</field>
        <field name="view_id" ref="quotation_template_content_it_religious"/>
        <field name="sequence">58</field>
    </record>

    <!-- PROVISIONAL: is_default_selection marks what NEW quotations get by
         default. Set here to IT Non Profit Proposal to match current live
         behaviour (see chat) - flip this flag in the UI, or ask to change it,
         if Default Odoo should be the starting point for new quotations instead. -->
    <record id="quotation_template_modern_digital_workplace" model="quotation.template">
        <field name="name">IT Non Profit Proposal</field>
        <field name="code">non_profit</field>
        <field name="view_id" ref="quotation_template_content_modern_digital_workplace"/>
        <field name="is_default_selection" eval="True"/>
        <field name="sequence">60</field>
    </record>

</odoo>
