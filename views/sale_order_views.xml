<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_quotation_template" model="ir.ui.view">
        <field name="name">sale.order.form.quotation.template</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="quotation_template_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
